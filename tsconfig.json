{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "tests/**/*.ts",
    "steps/**/*.ts",
    "pageObjects/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.bdd.ts"
  ]
}
